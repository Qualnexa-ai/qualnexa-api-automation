# Copy this file to .env to override local defaults.
# .env is gitignored — never commit real secrets there.

# Base URL of the target API under test
BASE_URL=https://petstore.swagger.io/v2

# Request timeout in milliseconds (also used as the Playwright per-test timeout)
API_TIMEOUT_MS=30000

# Optional: name+value of one header to attach to every outgoing request.
# Both are unset by default — Petstore needs no auth, so leave these blank
# unless testing against a real API that requires one. The value's format
# decides the scheme, e.g.:
#   API_AUTH_HEADER_NAME=Authorization
#   API_AUTH_HEADER_VALUE=Bearer <token>          # Bearer token
#   API_AUTH_HEADER_VALUE=Basic <base64-user:pass> # Basic auth
# or:
#   API_AUTH_HEADER_NAME=X-API-Key
#   API_AUTH_HEADER_VALUE=<key>                    # API key
# API_AUTH_HEADER_NAME=
# API_AUTH_HEADER_VALUE=
